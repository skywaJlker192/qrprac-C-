@page "/tasks/edit/{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Редактирование задачи";
}

<div class="glass auth-card wide">
    <h1 class="h3 mb-4"><i class="bi bi-pencil-square me-2"></i>Редактирование задачи</h1>

    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger glass-alert"></div>
        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control form-control-lg" />
            <span asp-validation-for="Input.Title" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger small"></span>
        </div>
        <div class="form-check mb-4">
            <input asp-for="Input.IsCompleted" class="form-check-input" />
            <label asp-for="Input.IsCompleted" class="form-check-label"></label>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-gradient px-4">Сохранить</button>
            <a class="btn btn-outline-light" asp-page="/Todos/Index">Отмена</a>
        </div>
    </form>
</div>
