@page "/tasks/delete/{id:int}"
@model DeleteModel
@{
    ViewData["Title"] = "Удаление задачи";
}

<div class="glass auth-card text-center">
    <div class="auth-icon"><i class="bi bi-trash3"></i></div>
    <h1 class="h4 mb-2">Удалить задачу?</h1>
    <p class="text-secondary mb-4">«@Model.Item.Title» будет удалена без возможности восстановления.</p>

    <form method="post" class="d-flex gap-2 justify-content-center">
        <button type="submit" class="btn btn-danger px-4">Да, удалить</button>
        <a class="btn btn-outline-light" asp-page="/Todos/Index">Отмена</a>
    </form>
</div>
