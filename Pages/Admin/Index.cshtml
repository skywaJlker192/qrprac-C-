@page "/admin"
@model AdminIndexModel
@{
    ViewData["Title"] = "Админ-панель";
}

<div class="mb-4">
    <h1 class="h2 mb-1"><i class="bi bi-people me-2"></i>Админ-панель</h1>
    <p class="text-secondary mb-0">Все пользователи и их роли. Роль можно изменить прямо здесь.</p>
</div>

<div class="glass p-3 p-md-4">
    <div class="table-responsive">
        <table class="table table-glass align-middle">
            <thead>
                <tr>
                    <th>Пользователь</th>
                    <th>Роли</th>
                    <th class="text-end">Изменить роль</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <span class="avatar">@(string.IsNullOrEmpty(u.FullName) ? "?" : u.FullName.Trim()[0].ToString().ToUpperInvariant())</span>
                                <div>
                                    <div class="fw-semibold">@u.FullName</div>
                                    <div class="text-secondary small">@u.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge rounded-pill @(r == "Admin" ? "text-bg-danger" : r == "Author" ? "text-bg-info" : "text-bg-secondary") px-3 py-2">@r</span>
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="ChangeRole" class="role-form">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <select name="role" class="form-select form-select-sm" aria-label="Роль">
                                    @foreach (var role in AppRoles.All)
                                    {
                                        <option value="@role" selected="@(role == u.CurrentRole)">@role</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-gradient">Применить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
